# Copy to frontend/.env.local if you need to change these (all optional).

# Where the Vite dev/preview server forwards /api requests (default below).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only for a production build served separately from the API:
# the absolute base URL of the backend (leave empty to use same-origin /api).
# VITE_API_BASE_URL=
