# Copy to `.env` (git-ignored) and adjust. Every value is optional.

# SQLAlchemy URL. Default: SQLite file at data/app.db
# DATABASE_URL=sqlite:///C:/path/to/app.db

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Authentication (see docs/AUTHENTICATION.md). There is NO default account:
#      create the first administrator with  python -m backend.app.create_admin --email you@example.com
# development | production  (production makes session cookies Secure: serve the app over HTTPS)
APP_ENV=development
# Let people register their own STUDENT account (default true). Administrators can never self-register.
ALLOW_SELF_REGISTRATION=true
# Session lifetime (hours); sign-in lockout after this many failures, for this many minutes
# SESSION_TTL_HOURS=8
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# Force the Secure cookie flag on/off (default: follows APP_ENV)
# COOKIE_SECURE=

# Seed sample data automatically when the database is empty
SEED_ON_STARTUP=true
SEED_RANDOM_STATE=42

# ML output locations (defaults: data/, models/, reports/)
# PLRS_DATA_DIR=
# PLRS_MODELS_DIR=
# PLRS_REPORTS_DIR=

# Train ML models in a background thread when the API starts (else on first AI request)
ML_TRAIN_ON_STARTUP=true

# AI assistant: auto (Claude if a key is set, else built-in) | rules | claude
ASSISTANT_PROVIDER=auto
# Optional Claude API key - the app works without it
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
